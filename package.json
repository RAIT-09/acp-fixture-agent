{
	"name": "acp-fixture-agent",
	"version": "0.0.0",
	"private": true,
	"description": "Deterministic, scenario-driven ACP agent for testing Agent Client Protocol clients",
	"keywords": [
		"acp",
		"agent-client-protocol",
		"testing",
		"fixture",
		"mock-agent"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RAIT-09/acp-fixture-agent.git"
	},
	"bugs": {
		"url": "https://github.com/RAIT-09/acp-fixture-agent/issues"
	},
	"homepage": "https://github.com/RAIT-09/acp-fixture-agent#readme",
	"type": "module",
	"bin": {
		"acp-fixture-agent": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx src/cli.ts",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"lint": "biome check .",
		"format": "biome check --write .",
		"prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "1.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^26.2.0",
		"tsx": "^4.23.11",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
